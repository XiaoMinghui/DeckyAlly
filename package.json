    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  }
}
